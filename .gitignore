# Secrets and local environment files
.env
.env.*
!.env.example
*.pem
*.key

# Python environments and generated bytecode
__pycache__/
*.py[cod]
.python-version
*.egg-info/
.venv/
.venv*/
venv/
env/

# Tool caches and coverage output
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build output and local database/model storage
/build/
/dist/
/qdrant_storage/
/qdrant_data/
/hf_cache/

# macOS, editor state, and temporary files
.DS_Store
._*
.idea/
.vscode/
*.swp
*.swo
*~
*.tmp
*.temp
/tmp/
/logs/
*.log

# artifacts/*.json là bằng chứng bắt buộc của bài nộp.
# Chỉ commit sau khi kiểm tra không có API key hoặc dữ liệu cá nhân thật.
# Giữ logs thực nghiệm đã kiểm tra để đối chiếu kết quả trong báo cáo.
!artifacts/run_logs/*.log
